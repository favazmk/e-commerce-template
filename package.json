{
  "name": "agency-ecommerce-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready, modular, multi-client reusable e-commerce engine",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "images:sync": "node scripts/sync-product-images.mjs",
    "images:check": "node scripts/sync-product-images.mjs --dry-run",
    "demo:seed": "node scripts/seed-demo-catalog.mjs",
    "db:migrate": "node scripts/apply-migration.mjs",
    "db:query": "node scripts/db-query.mjs",
    "verify:admin": "node scripts/verify-admin-crud.mjs",
    "verify:storage": "node scripts/verify-storage.mjs",
    "verify:security": "node scripts/verify-security.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "razorpay": "^2.9.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.1.7",
    "pg": "^8.23.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
