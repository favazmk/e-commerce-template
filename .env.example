# ==============================================================================
# AGENCY E-COMMERCE STARTER - ENVIRONMENT CONFIGURATION
# ------------------------------------------------------------------------------
# Copy to .env.local and fill in per deployment. Never commit real credentials
# to this repository (see AGENTS.md section 15).
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION MODE
# ------------------------------------------------------------------------------
# 'production' (default) | 'demo'
#
# Demo mode enables the simulated payment gateway for previews and design
# review. It must NEVER be set on a store that takes real money: it makes the
# checkout approve payments without charging anything.
#
# Both variables must agree — the server reads APP_MODE, the browser reads
# NEXT_PUBLIC_APP_MODE (it controls whether the demo gateway is offered in the UI).
APP_MODE=production
NEXT_PUBLIC_APP_MODE=production

# ------------------------------------------------------------------------------
# STORE IDENTITY (per client — this is what makes the template generic)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STORE_NAME=Your Store
NEXT_PUBLIC_STORE_TAGLINE=
NEXT_PUBLIC_STORE_DESCRIPTION=
NEXT_PUBLIC_BRAND_PRIMARY_COLOR=#0f172a

# SITE CONFIGURATION
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LOCALE=en-AE
NEXT_PUBLIC_HTML_LANG=en
NEXT_PUBLIC_DEFAULT_CURRENCY=AED
NEXT_PUBLIC_DEFAULT_CURRENCY_SYMBOL=AED 

# Prefix for generated order numbers, e.g. ORD-123456789. Letters/digits only.
ORDER_NUMBER_PREFIX=ORD

# ------------------------------------------------------------------------------
# SUPABASE / POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_* values are exposed to the browser by design. The service role
# key is server-only and must never be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# ------------------------------------------------------------------------------
# PAYMENT PROVIDERS
# ------------------------------------------------------------------------------
# Mode: 'razorpay' | 'mock'
# 'mock' approves every payment. Use it only alongside APP_MODE=demo.
DEFAULT_PAYMENT_PROVIDER=razorpay

# Razorpay Configuration (Server & Client)
# All three are required in production. Without the key secret, payment
# verification fails closed; without the webhook secret, webhooks are rejected.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourkeyid
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# EMAIL NOTIFICATIONS
# ------------------------------------------------------------------------------
# Mode: 'console' | 'resend'
# 'console' logs emails instead of sending them.
EMAIL_PROVIDER=console
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Store Support <orders@yourstore.com>"

# ------------------------------------------------------------------------------
# ANALYTICS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ------------------------------------------------------------------------------
# STORAGE PROVIDER
# ------------------------------------------------------------------------------
# Uploads go to Supabase Storage when the Supabase credentials above are set.
SUPABASE_STORAGE_BUCKET=ecommerce-assets

# ==============================================================================
# STORE CONTACT & LEGAL IDENTITY
# ------------------------------------------------------------------------------
# Used by the footer, the policy pages and schema.org Organization markup.
# Every value is optional: an unset field is omitted rather than rendered as a
# placeholder, because fake contact details in structured data are a Google
# policy violation and fake ones in a policy page are a legal problem.
#
# Payment providers (Razorpay, Stripe, PayPal) verify that a live merchant
# publishes reachable contact details before approving an account — fill these
# in before applying.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STORE_EMAIL=
NEXT_PUBLIC_STORE_PHONE=
NEXT_PUBLIC_STORE_WHATSAPP=
NEXT_PUBLIC_STORE_STREET=
NEXT_PUBLIC_STORE_CITY=
NEXT_PUBLIC_STORE_REGION=
NEXT_PUBLIC_STORE_POSTAL_CODE=
NEXT_PUBLIC_STORE_COUNTRY=
# Default country pre-filled in the address form, e.g. "United Arab Emirates".
NEXT_PUBLIC_DEFAULT_COUNTRY=
# Jurisdiction named in the Terms & Conditions, e.g. "the United Arab Emirates".
NEXT_PUBLIC_GOVERNING_LAW=

# Comma-separated absolute profile URLs, emitted as schema.org `sameAs`.
# e.g. https://instagram.com/yourstore,https://facebook.com/yourstore
NEXT_PUBLIC_SOCIAL_PROFILES=

# Brand artwork. The logo appears in Organization markup and rich results; the
# icons are used by the PWA manifest (add real PNGs for installable apps).
NEXT_PUBLIC_STORE_LOGO_URL=/logo.svg
NEXT_PUBLIC_STORE_ICON_URL=/logo.svg
NEXT_PUBLIC_STORE_ICON_192=
NEXT_PUBLIC_STORE_ICON_512=

# ==============================================================================
# SEO & SEARCH CONSOLE
# ------------------------------------------------------------------------------
# Verification tokens (the content= value from each provider's meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_PINTEREST_VERIFICATION=

# Force-disable indexing on a deployment that would otherwise be indexable.
# Preview and demo deployments are excluded automatically; this is the manual
# override for, say, a soft launch on the production domain.
NEXT_PUBLIC_ALLOW_INDEXING=true

# Google product taxonomy id or full path for the Merchant Center feed.
# Find yours at https://www.google.com/basepages/producttype/taxonomy.en-US.txt
# e.g. "Apparel & Accessories > Clothing" — improves Shopping ad targeting.
NEXT_PUBLIC_GOOGLE_PRODUCT_CATEGORY=

# ==============================================================================
# ADVERTISING & MEASUREMENT
# ------------------------------------------------------------------------------
# All optional. With none set, the storefront loads no third-party tags at all
# and the cookie banner does not appear (there is nothing to consent to).
#
# Consent Mode v2 is wired up: everything starts denied and is only granted
# after the visitor agrees. That is mandatory for EEA/UK traffic and is what
# keeps Google Ads conversion reporting working.
# ------------------------------------------------------------------------------
# GA4 measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Ads conversion id, e.g. AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion label for the "Purchase" action (Google Ads → Goals → Conversions).
# Without it, purchases report to GA4 but not to the Ads conversion column that
# smart bidding optimises against.
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
# Google Tag Manager container, e.g. GTM-XXXXXXX. Use this OR the GA4 id above.
NEXT_PUBLIC_GTM_ID=
# Meta (Facebook/Instagram) Pixel id.
NEXT_PUBLIC_META_PIXEL_ID=

# ==============================================================================
# CONTENT SECURITY POLICY
# ------------------------------------------------------------------------------
# 'enforce' (default) | 'report-only' | 'off'
# Use report-only while adding a new third-party widget, check the browser
# console for violations, then switch back to enforce.
CSP_MODE=enforce

# Extra hosts a client store needs (live chat, review widget, etc.).
# Comma-separated origins, e.g. https://widget.example.com
CSP_EXTRA_SCRIPT_SRC=
CSP_EXTRA_CONNECT_SRC=
CSP_EXTRA_IMG_SRC=
CSP_EXTRA_FRAME_SRC=
