# ==============================================================================
# AGENCY E-COMMERCE STARTER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# SITE CONFIGURATION
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_DEFAULT_CURRENCY_SYMBOL=$

# SUPABASE / POSTGRESQL DATABASE
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# PAYMENT PROVIDERS
# Mode: 'razorpay' | 'stripe' | 'mock'
DEFAULT_PAYMENT_PROVIDER=mock

# Razorpay Configuration (Server & Client)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourkeyid
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Stripe Configuration (Alternative provider)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# EMAIL NOTIFICATIONS
# Mode: 'console' | 'resend' | 'smtp'
EMAIL_PROVIDER=console
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Store Support <orders@yourstore.com>"

# ANALYTICS
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# STORAGE PROVIDER
# Mode: 'supabase' | 'local'
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=ecommerce-assets

# AUTH & SESSION
JWT_SECRET=super-secure-random-jwt-secret-min-32-chars
ADMIN_DEFAULT_EMAIL=admin@store.com
ADMIN_DEFAULT_PASSWORD=AdminSecurePassword123!
